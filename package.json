{
  "name": "master-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && npm run test:unit && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "npx tsx src/scripts/validate-data.ts",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:all": "npm run validate && npm run test:unit"
  },
  "dependencies": {
    "astro": "7.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "3.9.5",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
