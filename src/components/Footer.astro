---
// src/components/Footer.astro
import type { Contact } from '@/types';
import { buildPhoneLink, buildWhatsAppUrl, formatPhoneDisplay } from '@/utils/contacts';

interface Props {
  contacts: Contact;
}

const { contacts } = Astro.props;

// Генерируем ссылки с помощью утилит
const phoneLink = buildPhoneLink(contacts.phone);
const phoneDisplay = formatPhoneDisplay(contacts.phone);
const whatsappUrl = buildWhatsAppUrl(
  contacts.whatsapp,
  `Здравствуйте! Интересуют услуги мастера по ремонту.`
);

// Текущий год для копирайта
const currentYear = new Date().getFullYear();

// Навигация (дублируем меню для SEO и удобства)
const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/services/', label: 'Услуги' },
  { href: '/portfolio/', label: 'Портфолио' },
  { href: '/about/', label: 'О мастере' },
];

// Социальные сети
const socialLinks = [
  {
    href: contacts.socialMedia.vk,
    icon: 'bi-chat-fill',
    label: 'ВКонтакте',
    show: Boolean(contacts.socialMedia.vk),
  },
  {
    href: contacts.socialMedia.instagram,
    icon: 'bi-instagram',
    label: 'Instagram',
    show: Boolean(contacts.socialMedia.instagram),
  },
  {
    href: `https://t.me/${contacts.telegram}`,
    icon: 'bi-telegram',
    label: 'Telegram',
    show: Boolean(contacts.telegram),
  },
  {
    href: whatsappUrl,
    icon: 'bi-whatsapp',
    label: 'WhatsApp',
    show: true,
  },
];

// Услуги для быстрого доступа
const serviceLinks = [
  { href: '/services/electric/', label: 'Электромонтаж' },
  { href: '/services/ceiling/', label: 'Натяжные потолки' },
  { href: '/services/tiles/', label: 'Укладка плитки' },
];
---

<footer class="footer" role="contentinfo" aria-labelledby="footer-heading">
  
  <div class="container">
  <h2 id="footer-heading" class="visually-hidden">
    Контактная информация и навигация
  </h2>
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- ВЕРХНЯЯ ЧАСТЬ: 4 колонки с контентом                    -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div class="footer__main">
      <div class="row g-4 g-lg-5">
        
        <!-- Колонка 1: О мастере и город -->
        <div class="col-md-6 col-lg-3">
          <div class="footer__brand">
            <div class="footer__logo">
              <i class="bi bi-tools footer__logo-icon" aria-hidden="true"></i>
              <span class="footer__logo-text">
                Мастер по ремонту
              </span>
            </div>
            
            <p class="footer__description">
              Профессиональный мастер в {contacts.city_dative_case}. 
              Работаю по договору с гарантией до 3 лет.
            </p>
            
            <div class="footer__city">
              <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
              <span>{contacts.city} и область</span>
            </div>
          </div>
        </div>
        
        <!-- Колонка 2: Навигация -->
        <div class="col-md-6 col-lg-2">
          <h3 class="footer__heading">Навигация</h3>
          <nav aria-label="Навигация в подвале">
            <ul class="footer__nav">
              {navLinks.map(link => (
                <li>
                  <a href={link.href} class="footer__link">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
        
        <!-- Колонка 3: Услуги -->
        <div class="col-md-6 col-lg-3">
          <h3 class="footer__heading">Услуги</h3>
          <nav aria-label="Список услуг">
            <ul class="footer__nav">
              {serviceLinks.map(link => (
                <li>
                  <a href={link.href} class="footer__link">
                    {link.label}
                  </a>
                </li>
              ))}
              <li>
                <a href="/services/" class="footer__link footer__link--accent">
                  Все услуги →
                </a>
              </li>
            </ul>
          </nav>
        </div>
        
        <!-- Колонка 4: Контакты -->
        <div class="col-md-6 col-lg-4">
          <h3 class="footer__heading">Контакты</h3>
          
          <ul class="footer__contacts">
            <!-- Телефон -->
            <li class="footer__contact-item">
              <i class="bi bi-telephone-fill footer__contact-icon" aria-hidden="true"></i>
              <div class="footer__contact-content">
                <a href={phoneLink} class="footer__contact-link">
                  {phoneDisplay}
                </a>
                <span class="footer__contact-label">Звоните, отвечу сразу</span>
              </div>
            </li>
            
            <!-- Email -->
            <li class="footer__contact-item">
              <i class="bi bi-envelope-fill footer__contact-icon" aria-hidden="true"></i>
              <div class="footer__contact-content">
                <a href={`mailto:${contacts.email}`} class="footer__contact-link">
                  {contacts.email}
                </a>
                <span class="footer__contact-label">Для заявок и вопросов</span>
              </div>
            </li>
            
            <!-- Часы работы -->
            <li class="footer__contact-item">
              <i class="bi bi-clock-fill footer__contact-icon" aria-hidden="true"></i>
              <div class="footer__contact-content">
                <span class="footer__contact-text">
                  {contacts.workingHours}
                </span>
                <span class="footer__contact-label">Без выходных</span>
              </div>
            </li>
          </ul>
          
          <!-- Социальные сети -->
          <div class="footer__social">
            {socialLinks.filter(s => s.show).map(social => (
              <a 
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="footer__social-link"
                aria-label={social.label}
                title={social.label}
              >
                <i class={`bi ${social.icon}`} aria-hidden="true"></i>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- РАЗДЕЛИТЕЛЬ                                             -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <hr class="footer__divider" />
    
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- НИЖНЯЯ ЧАСТЬ: копирайт и юридическая информация         -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div class="footer__bottom">
      <div class="row align-items-center g-3">
        
        <!-- Копирайт -->
        <div class="col-md-6 text-center text-md-start">
          <p class="footer__copyright">
            © {currentYear} Мастер по ремонту • {contacts.city}
          </p>
        </div>
        
        <!-- Юридические ссылки -->
        <div class="col-md-6 text-center text-md-end">
          <ul class="footer__legal">
            <li>
              <a href="/privacy/" class="footer__legal-link">
                Политика конфиденциальности
              </a>
            </li>
            <li>
              <span class="footer__legal-separator" aria-hidden="true">•</span>
            </li>
            <li>
              <a href="/sitemap-index.xml" class="footer__legal-link" target="_blank" rel="noopener">
                Карта сайта
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0f172a;
    color: #cbd5e1;
    padding: 4rem 0 0;
    margin-top: 0;
  }
  
  /* ═══════════════════════════════════════════════════ */
  /* ВЕРХНЯЯ ЧАСТЬ                                      */
  /* ═══════════════════════════════════════════════════ */
  
  .footer__main {
    padding-bottom: 3rem;
  }
  
  /* Бренд и описание */
  .footer__logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  
  .footer__logo-icon {
    font-size: 1.75rem;
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }
  
  .footer__logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    line-height: 1.2;
  }
  
  .footer__description {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }
  
  .footer__city {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(37, 99, 235, 0.15);
    color: #93c5fd;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  
  .footer__city i {
    color: #fbbf24;
  }
  
  /* Заголовки колонок */
  .footer__heading {
    font-size: 1rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    padding-bottom: 0.75rem;
  }
  
  .footer__heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background: #2563eb;
    border-radius: 2px;
  }
  
  /* Навигационные списки */
  .footer__nav {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  
  .footer__link {
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s ease, padding-left 0.2s ease;
    display: inline-block;
  }
  
  .footer__link:hover {
    color: white;
    padding-left: 4px;
  }
  
  .footer__link--accent {
    color: #60a5fa;
    font-weight: 600;
    margin-top: 0.5rem;
  }
  
  .footer__link--accent:hover {
    color: #93c5fd;
  }
  
  /* Контакты */
  .footer__contacts {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .footer__contact-item {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
  }
  
  .footer__contact-icon {
    font-size: 1.25rem;
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  
  .footer__contact-content {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  
  .footer__contact-link {
    color: white;
    text-decoration: none;
    font-size: 1.0625rem;
    font-weight: 600;
    transition: color 0.2s ease;
    word-break: break-word;
  }
  
  .footer__contact-link:hover {
    color: #60a5fa;
  }
  
  .footer__contact-text {
    color: white;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  
  .footer__contact-label {
    font-size: 0.8125rem;
    color: #94a3b8;
    line-height: 1.4;
  }
  
  /* Социальные сети */
  .footer__social {
    display: flex;
    gap: 0.625rem;
    flex-wrap: wrap;
  }
  
  .footer__social-link {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    border-radius: 10px;
    text-decoration: none;
    font-size: 1.25rem;
    transition: all 0.3s ease;
  }
  
  .footer__social-link:hover {
    background: #2563eb;
    transform: translateY(-2px);
  }
  
  .footer__social-link:hover i.bi-instagram {
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .footer__social-link:hover i.bi-whatsapp {
    color: #25d366;
  }
  
  .footer__social-link:hover i.bi-telegram {
    color: #0088cc;
  }
  
  .footer__social-link:hover i.bi-chat-fill {
    color: #4c75a3;
  }
  
  /* ═══════════════════════════════════════════════════ */
  /* РАЗДЕЛИТЕЛЬ                                         */
  /* ═══════════════════════════════════════════════════ */
  
  .footer__divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 0;
    opacity: 1;
  }
  
  /* ═══════════════════════════════════════════════════ */
  /* НИЖНЯЯ ЧАСТЬ                                        */
  /* ═══════════════════════════════════════════════════ */
  
  .footer__bottom {
    padding: 1.5rem 0;
  }
  
  .footer__copyright {
    font-size: 0.875rem;
    color: #94a3b8;
    margin: 0;
  }
  
  .footer__legal {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  
  .footer__legal-link {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }
  
  .footer__legal-link:hover {
    color: white;
  }
  
  .footer__legal-separator {
    color: #475569;
  }
  
  /* ═══════════════════════════════════════════════════ */
  /* АДАПТИВНОСТЬ                                        */
  /* ═══════════════════════════════════════════════════ */
  
  @media (max-width: 767px) {
    .footer {
      padding: 3rem 0 0;
      text-align: center;
    }
    
    .footer__main {
      padding-bottom: 2rem;
    }
    
    .footer__logo {
      justify-content: center;
    }
    
    .footer__heading::after {
      left: 50%;
      transform: translateX(-50%);
    }
    
    .footer__nav {
      align-items: center;
    }
    
    .footer__contacts {
      align-items: center;
    }
    
    .footer__contact-item {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    .footer__contact-content {
      align-items: center;
    }
    
    .footer__social {
      justify-content: center;
    }
    
    .footer__bottom {
      padding: 1.25rem 0;
    }
    
    .footer__copyright {
      margin-bottom: 0.75rem;
    }
  }
  
  @media (min-width: 768px) and (max-width: 991px) {
    .footer__main .row > div:nth-child(odd) {
      margin-bottom: 1.5rem;
    }
  }
</style>