---
// src/components/Hero.astro
import contacts from '@/data/contacts.json';
import { buildPhoneLink, buildWhatsAppUrl, formatPhoneDisplay } from '@/utils/contacts';

interface Props {
  city: string;
}

const { city } = Astro.props;

// Генерируем ссылки для CTA
const phoneLink = buildPhoneLink(contacts.phone);
const whatsappUrl = buildWhatsAppUrl(
  contacts.whatsapp,
  `Здравствуйте! Интересуют услуги мастера по ремонту в ${city}.`
);
const phoneDisplay = formatPhoneDisplay(contacts.phone);

// Преимущества (можно вынести в JSON, но для простоты хардкодим)
const advantages = [
  {
    icon: 'bi-shield-check',
    title: 'Гарантия 3 года',
    description: 'На все виды работ'
  },
  {
    icon: 'bi-file-earmark-text',
    title: 'Официальный договор',
    description: 'Фиксируем сроки и цену'
  },
  {
    icon: 'bi-camera',
    title: 'Фотоотчёты',
    description: 'Каждый этап работ'
  }
];
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="row align-items-center g-5">
      <!-- Левая колонка: текст и CTA -->
      <div class="col-lg-7 text-center text-lg-start">
        
        <!-- Социальное доказательство -->
        <div class="hero__rating mb-3">
          <span class="hero__rating-badge">
            <i class="bi bi-star-fill" aria-hidden="true"></i>
            4.9
          </span>
          <span class="hero__rating-text">
            на основе <strong>47 отзывов</strong> клиентов
          </span>
        </div>
        
        <!-- Главный заголовок (H1 — только один на странице!) -->
        <h1 id="hero-heading" class="hero__title">
          Мастер по ремонту
          <span class="hero__title-accent">в {city}</span>
        </h1>
        
        <!-- Подзаголовок -->
        <p class="hero__subtitle">
          Электромонтаж • Натяжные потолки • Укладка плитки<br>
          Работаем по договору с гарантией до 3 лет
        </p>
        
        <!-- CTA-кнопки -->
        <div class="hero__cta d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start mb-4">
          <a 
            href={phoneLink}
            class="btn btn-light btn-lg hero__cta-primary"
            aria-label={`Позвонить по номеру ${phoneDisplay}`}
          >
            <i class="bi bi-telephone-fill me-2" aria-hidden="true"></i>
            <span class="hero__cta-text">
              <span class="hero__cta-label d-none d-sm-inline">Позвонить:</span>
              {phoneDisplay}
            </span>
          </a>
          
          <a 
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-success btn-lg hero__cta-secondary"
            aria-label="Написать в WhatsApp"
          >
            <i class="bi bi-whatsapp me-2" aria-hidden="true"></i>
            Написать в WhatsApp
          </a>
        </div>
        
        <!-- Преимущества -->
        <div class="hero__advantages">
          <div class="row g-3">
            {advantages.map(adv => (
              <div class="col-12 col-sm-4">
                <div class="hero__advantage d-flex align-items-center">
                  <i class={`bi ${adv.icon} hero__advantage-icon`} aria-hidden="true"></i>
                  <div class="hero__advantage-text">
                    <div class="hero__advantage-title">{adv.title}</div>
                    <div class="hero__advantage-desc">{adv.description}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Правая колонка: фото мастера (только на desktop) -->
      <div class="col-lg-5 text-center d-none d-lg-block">
        <div class="hero__image-wrapper">
          <img 
            src="/images/master-photo.webp"
            alt="Мастер по ремонту за работой"
            class="hero__image"
            width="400"
            height="400"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
    color: white;
    padding: 4rem 0;
    position: relative;
    overflow: hidden;
  }
  
  /* Декоративные круги на фоне */
  .hero::before {
    content: '';
    position: absolute;
    top: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 50%;
    pointer-events: none;
  }
  
  .hero::after {
    content: '';
    position: absolute;
    bottom: -150px;
    left: -150px;
    width: 500px;
    height: 500px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 50%;
    pointer-events: none;
  }
  
  .hero > .container {
    position: relative;
    z-index: 1;
  }
  
  /* Рейтинг */
  .hero__rating {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  
  @media (min-width: 992px) {
    .hero__rating {
      justify-content: flex-start;
    }
  }
  
  .hero__rating-badge {
    background: #fbbf24;
    color: #1e293b;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .hero__rating-text {
    font-size: 0.95rem;
    opacity: 0.9;
  }
  
  /* Заголовок */
  .hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  
  .hero__title-accent {
    color: #fbbf24;
    display: block;
  }
  
  /* Подзаголовок */
  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.6;
    margin-bottom: 2rem;
    opacity: 0.95;
  }
  
  /* CTA-кнопки */
  .hero__cta-primary {
    background: white;
    color: #2563eb;
    border: none;
    font-weight: 600;
    padding: 0.875rem 1.75rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
  }
  
  .hero__cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    background: #f8fafc;
  }
  
  .hero__cta-secondary {
    background: #25d366;
    border: none;
    font-weight: 600;
    padding: 0.875rem 1.75rem;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
    transition: all 0.3s ease;
  }
  
  .hero__cta-secondary:hover {
    background: #20ba5a;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
  }
  
  .hero__cta-label {
    font-weight: 400;
    opacity: 0.8;
    margin-right: 0.25rem;
  }
  
  /* Преимущества */
  .hero__advantages {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  
  .hero__advantage {
    gap: 0.75rem;
  }
  
  .hero__advantage-icon {
    font-size: 2rem;
    color: #fbbf24;
    flex-shrink: 0;
  }
  
  .hero__advantage-title {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
  }
  
  .hero__advantage-desc {
    font-size: 0.875rem;
    opacity: 0.8;
    line-height: 1.4;
  }
  
  /* Фото мастера */
  .hero__image-wrapper {
    position: relative;
    display: inline-block;
  }
  
  .hero__image {
    border-radius: 50%;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    border: 6px solid rgba(255, 255, 255, 0.2);
    max-width: 100%;
    height: auto;
  }
  
  /* Адаптивность */
  @media (max-width: 575px) {
    .hero {
      padding: 3rem 0;
    }
    
    .hero__cta .btn {
      width: 100%;
    }
  }
  
  @media (min-width: 576px) and (max-width: 991px) {
    .hero__advantage {
      justify-content: center;
    }
  }
</style>