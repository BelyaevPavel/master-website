---
import contacts from '@/data/contacts.json';

interface Props {
  city: string;
}

const { city } = Astro.props;
const currentUrl = Astro.url.pathname;
---

<header class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
  <div class="container">
    <a href="/" class="navbar-brand fw-bold">
      Мастер по ремонту • {city}
    </a>
    
    <button class="navbar-toggler" type="button" 
            data-bs-toggle="collapse" 
            data-bs-target="#mainNav"
            aria-controls="mainNav" 
            aria-expanded="false" 
            aria-label="Переключить навигацию">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <nav class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <li class="nav-item"><a href="/" class="nav-link">Главная</a></li>
        <li class="nav-item"><a href="/services/" class="nav-link">Услуги</a></li>
        <li class="nav-item"><a href="/portfolio/" class="nav-link">Портфолио</a></li>
        <li class="nav-item"><a href="/about/" class="nav-link">О мастере</a></li>
        <li class="nav-item ms-lg-3">
          <a href={`tel:${contacts.phone}`} class="btn btn-outline-primary me-2">
            <i class="bi bi-telephone"></i> Позвонить
          </a>
        </li>
        <li class="nav-item">
          <a href={`https://wa.me/${contacts.whatsapp}?text=${encodeURIComponent('Здравствуйте! Интересуют услуги ремонта.')}`} 
             target="_blank" rel="noopener noreferrer"
             class="btn btn-success">
            <i class="bi bi-whatsapp"></i> WhatsApp
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>