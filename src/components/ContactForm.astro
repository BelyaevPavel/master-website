---
// Замените YOUR_FORM_ID на ваш ID с formspree.io
const formspreeId = 'YOUR_FORM_ID';
---

<section class="contact-form py-5 bg-light" id="contact-form" aria-labelledby="form-heading">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="text-center mb-5">
          <h2 id="form-heading" class="display-5 fw-bold mb-3">
            Оставьте заявку
          </h2>
          <p class="lead text-muted">
            Перезвоню в течение 15 минут и отвечу на все вопросы
          </p>
        </div>
        
        <form 
          action={`https://formspree.io/f/${formspreeId}`}
          method="POST"
          class="form-card p-4 p-md-5 bg-white rounded-3 shadow-sm"
        >
          <div class="row g-3">
            <div class="col-md-6">
              <label for="name" class="form-label">Ваше имя *</label>
              <input 
                type="text" 
                class="form-control form-control-lg" 
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Как к вам обращаться?"
              />
            </div>
            
            <div class="col-md-6">
              <label for="phone" class="form-label">Телефон *</label>
              <input 
                type="tel" 
                class="form-control form-control-lg" 
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                placeholder="+7 (___) ___-__-__"
                pattern="[\+]?[0-9\s\-\(\)]{10,}"
              />
            </div>
            
            <div class="col-12">
              <label for="service" class="form-label">Какая услуга интересует?</label>
              <select class="form-select form-select-lg" id="service" name="service">
                <option value="">Выберите услугу</option>
                <option value="electric">Электромонтаж</option>
                <option value="ceiling">Натяжные потолки</option>
                <option value="tiles">Укладка плитки</option>
                <option value="other">Другое</option>
              </select>
            </div>
            
            <div class="col-12">
              <label for="message" class="form-label">Комментарий</label>
              <textarea 
                class="form-control" 
                id="message"
                name="message"
                rows="4"
                placeholder="Опишите задачу: площадь, сроки, особенности..."
              ></textarea>
            </div>
            
            <div class="col-12">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="privacy" required />
                <label class="form-check-label small" for="privacy">
                  Согласен на обработку персональных данных
                </label>
              </div>
            </div>
            
            <div class="col-12">
              <button type="submit" class="btn btn-primary btn-lg w-100">
                <i class="bi bi-send me-2"></i>
                Отправить заявку
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .form-card {
    border: 1px solid rgba(37, 99, 235, 0.1);
  }
  
  .form-control:focus,
  .form-select:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.15);
  }
</style>