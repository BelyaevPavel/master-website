---
// import contacts from '@/data/contacts.json';
import {contacts} from '@/config/contacts'
import { getMessengerLink, getMessengerConfig } from '@/utils/contacts';

interface Props {
  type?: 'whatsapp' | 'telegram' | 'vkontakte';
  message?: string;
  text?: string;
  size?: 'sm' | 'md' | 'lg';
  className?: string;
  showIcon?: boolean;
}

const {
  type = contacts.preferredMessenger || 'whatsapp',
  message = 'Здравствуйте! Интересуют услуги ремонта.',
  text = '',
  size = 'md',
  className = '',
  showIcon = true,
} = Astro.props;

const link = getMessengerLink(type, contacts, message);

// Маппинг для иконок, цветов, текстов
const config = getMessengerConfig(type);

const buttonText = text || config.defaultText;

const sizeClass = size === 'lg' ? 'btn-lg' : size === 'sm' ? 'btn-sm' : '';
const typeClass = `btn-${type}`;
const allClasses = `btn ${sizeClass} ${typeClass} btn-messenger ${className}`.trim();
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class={allClasses}
  aria-label={buttonText}
>
  {showIcon && <i class={`bi ${config.icon} me-2`} aria-hidden="true"></i>}
  {buttonText}
</a>

<style>
  /* Общие стили для всех кнопок мессенджеров */
  .btn-messenger {
    border: none;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    transition: all 0.3s ease;
    color: white;
  }

  .btn-messenger:hover {
    filter: brightness(0.92);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
  }

  /* Цвета для каждого мессенджера */
  .btn-whatsapp {
    background-color: #25d366;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
  }
  .btn-whatsapp:hover {
    background-color: #20ba5a;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
  }

  .btn-telegram {
    background-color: #0088cc;
    box-shadow: 0 4px 15px rgba(0, 136, 204, 0.4);
  }
  .btn-telegram:hover {
    background-color: #0077b3;
    box-shadow: 0 6px 20px rgba(0, 136, 204, 0.5);
  }

  .btn-vkontakte {
    background-color: #4c75a3;
    box-shadow: 0 4px 15px rgba(76, 117, 163, 0.4);
  }
  .btn-vkontakte:hover {
    background-color: #42648d;
    box-shadow: 0 6px 20px rgba(76, 117, 163, 0.5);
  }

  /* Размеры */
  .btn-messenger.btn-lg {
    padding: 0.875rem 1.75rem;
    font-size: 1.125rem;
  }
  .btn-messenger.btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }
</style>