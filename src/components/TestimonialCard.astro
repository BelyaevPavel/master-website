---
// src/components/TestimonialCard.astro
import type { Testimonial } from '@/types';
import { getInitials } from '@/utils/reviews';
import { formatDate } from '@/utils/format';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;

// Генерируем инициалы для плейсхолдера
const initials = getInitials(testimonial.name);

// Форматируем дату в "Октябрь 2024"
const formattedDate = formatDate(testimonial.date);

// Проверяем, есть ли фото
const hasPhoto = testimonial.photo && testimonial.photo.trim() !== '';
---

<article class="testimonial-card" aria-labelledby={`testimonial-${testimonial.name}`}>
  <!-- Декоративная кавычка -->
  <div class="testimonial-card__quote" aria-hidden="true">"</div>
  
  <div class="testimonial-card__content">
    <!-- Шапка: аватар и имя -->
    <div class="testimonial-card__header">
      {hasPhoto ? (
        <img 
          src={testimonial.photo}
          alt={`Фото клиента ${testimonial.name}`}
          class="testimonial-card__avatar"
          width="60"
          height="60"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div 
          class="testimonial-card__avatar testimonial-card__avatar--placeholder"
          aria-label={`Аватар клиента ${testimonial.name}`}
        >
          {initials}
        </div>
      )}
      
      <div class="testimonial-card__info">
        <h3 id={`testimonial-${testimonial.name}`} class="testimonial-card__name">
          {testimonial.name}
        </h3>
        <p class="testimonial-card__service">
          {testimonial.service}
        </p>
      </div>
    </div>
    
    <!-- Рейтинг -->
    <div class="testimonial-card__rating" role="img" aria-label="Оценка 5 из 5">
      {[...Array(5)].map(() => (
        <i class="bi bi-star-fill" aria-hidden="true"></i>
      ))}
    </div>
    
    <!-- Текст отзыва -->
    <blockquote class="testimonial-card__text">
      <p>{testimonial.text}</p>
    </blockquote>
    
    <!-- Дата -->
    <footer class="testimonial-card__footer">
      <time datetime={testimonial.date}>
        {formattedDate}
      </time>
    </footer>
  </div>
</article>

<style>
  .testimonial-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }
  
  /* Декоративная кавычка */
  .testimonial-card__quote {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-size: 5rem;
    font-family: Georgia, serif;
    color: rgba(37, 99, 235, 0.1);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  
  .testimonial-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  
  /* Шапка */
  .testimonial-card__header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  
  .testimonial-card__avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
  
  .testimonial-card__avatar--placeholder {
    background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
  }
  
  .testimonial-card__info {
    flex: 1;
    min-width: 0; /* Для text-overflow */
  }
  
  .testimonial-card__name {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    color: #1e293b;
    line-height: 1.3;
  }
  
  .testimonial-card__service {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0;
    line-height: 1.4;
  }
  
  /* Рейтинг */
  .testimonial-card__rating {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }
  
  .testimonial-card__rating i {
    color: #fbbf24;
    font-size: 1.125rem;
  }
  
  /* Текст отзыва */
  .testimonial-card__text {
    margin: 0 0 1rem 0;
    padding: 0;
    border: none;
    flex: 1;
  }
  
  .testimonial-card__text p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
    font-style: italic;
  }
  
  /* Дата */
  .testimonial-card__footer {
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
    margin-top: auto;
  }
  
  .testimonial-card__footer time {
    font-size: 0.875rem;
    color: #94a3b8;
    font-weight: 500;
  }
  
  /* Адаптивность */
  @media (max-width: 575px) {
    .testimonial-card {
      padding: 1.25rem;
    }
    
    .testimonial-card__quote {
      font-size: 4rem;
      top: 0.5rem;
      right: 1rem;
    }
    
    .testimonial-card__avatar {
      width: 50px;
      height: 50px;
    }
    
    .testimonial-card__avatar--placeholder {
      font-size: 1.25rem;
    }
    
    .testimonial-card__name {
      font-size: 1rem;
    }
  }
</style>