---
// src/components/FAQ.astro
import defaultFaq from '@/data/faq.json';

interface Props {
  items?: { question: string; answer: string }[];
}

const { items: propItems } = Astro.props;
const faqData = propItems ?? defaultFaq;

// Генерируем JSON‑LD для Schema.org (FAQPage) на основе актуальных данных
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqData.map(item => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
};
---

<section class="faq" aria-labelledby="faq-heading">
  <div class="container">
    <!-- Заголовок секции -->
    <div class="faq__header text-center mb-5">
      <h2 id="faq-heading" class="faq__title">
        Частые вопросы
      </h2>
      <p class="faq__subtitle">
        Ответы на популярные вопросы о наших услугах
      </p>
    </div>
    
    <!-- Аккордеон -->
    <div class="accordion faq__accordion" id="faqAccordion">
      {faqData.map((item, index) => {
        const itemId = `faq-${index}`;
        const collapseId = `faq-collapse-${index}`;
        
        return (
          <div class="accordion-item faq__item border-0 mb-3" data-testid="faq-item">
            <h3 class="accordion-header" id={itemId}>
              <button
                class="accordion-button collapsed faq__button"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target={`#${collapseId}`}
                aria-expanded="false"
                aria-controls={collapseId}
                data-testid="faq-question"
              >
                {item.question}
              </button>
            </h3>
            
            <div
              id={collapseId}
              class="accordion-collapse collapse"
              aria-labelledby={itemId}
              data-bs-parent="#faqAccordion"
              data-testid="faq-answer"
            >
              <div class="accordion-body faq__answer">
                {item.answer}
              </div>
            </div>
          </div>
        );
      })}
    </div>
    
    <!-- Дополнительный CTA -->
    <div class="faq__cta text-center mt-5">
      <p class="faq__cta-text">
        Не нашли ответ на свой вопрос?
      </p>
      <a href="#contact-form" class="btn btn-outline-primary btn-lg">
        Задать вопрос
        <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<!-- Schema.org JSON-LD разметка для SEO -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq {
    padding: 5rem 0;
    background: #f8fafc;
  }
  
  /* Заголовок */
  .faq__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 1rem;
    color: #1e293b;
  }
  
  .faq__subtitle {
    font-size: 1.125rem;
    color: #64748b;
    max-width: 600px;
    margin: 0 auto;
  }
  
  /* Аккордеон */
  .faq__accordion {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .faq__item {
    background: white;
    border-radius: 12px !important;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.3s ease;
  }
  
  .faq__item:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }
  
  /* Кнопка вопроса */
  .faq__button {
    background: white;
    border: none;
    padding: 1.25rem 1.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #1e293b;
    text-align: left;
    width: 100%;
    transition: all 0.3s ease;
    border-radius: 12px !important;
  }
  
  .faq__button:not(.collapsed) {
    background: #eff6ff;
    color: #2563eb;
    box-shadow: inset 0 -1px 0 #e2e8f0;
  }
  
  .faq__button:focus {
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
    outline: none;
  }
  
  .faq__button::after {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%232563eb'%3e%3cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e");
    background-size: 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.3s ease;
  }
  
  .faq__button:not(.collapsed)::after {
    transform: rotate(-180deg);
  }
  
  /* Ответ */
  .faq__answer {
    padding: 1.25rem 1.5rem;
    background: white;
    color: #475569;
    line-height: 1.7;
    font-size: 1rem;
  }
  
  /* CTA */
  .faq__cta {
    padding: 2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    max-width: 600px;
    margin: 0 auto;
  }
  
  .faq__cta-text {
    font-size: 1.125rem;
    color: #475569;
    margin-bottom: 1rem;
  }
  
  .faq__cta .btn {
    font-weight: 600;
    padding: 0.75rem 2rem;
  }
  
  /* Адаптивность */
  @media (max-width: 767px) {
    .faq {
      padding: 3rem 0;
    }
    
    .faq__button {
      padding: 1rem 1.25rem;
      font-size: 1rem;
    }
    
    .faq__answer {
      padding: 1rem 1.25rem;
      font-size: 0.9375rem;
    }
    
    .faq__cta {
      padding: 1.5rem;
    }
  }
</style>