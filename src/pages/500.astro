---
import contacts from '@/data/contacts.json';
const cleanPhone = contacts.phone.replace(/\D/g, '');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ведутся технические работы | Мастер по ремонту</title>
    <style>
      /* Автономные стили, не зависящие от Bootstrap и внешних CDN */
      :root {
        --primary: #2563eb;
        --success: #198754;
        --text: #212529;
        --muted: #6c757d;
        --bg: #f8f9fa;
      }
      
      * { box-sizing: border-box; margin: 0; padding: 0; }
      
      body {
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background-color: var(--bg);
        color: var(--text);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
        text-align: center;
      }
      
      .error-code {
        font-size: 10rem;
        font-weight: 800;
        color: var(--primary);
        line-height: 1;
        opacity: 0.1;
        position: absolute;
        top: 10%;
        z-index: -1;
        pointer-events: none;
      }
      
      .icon-wrench {
        color: var(--primary);
        margin-bottom: 1.5rem;
        animation: spin 3s linear infinite;
      }
      
      @keyframes spin {
        0% { transform: rotate(0deg); }
        20% { transform: rotate(45deg); }
        40% { transform: rotate(0deg); }
        100% { transform: rotate(0deg); }
      }
      
      h1 { font-size: 2rem; margin-bottom: 1rem; color: var(--text); }
      p { font-size: 1.1rem; color: var(--muted); margin-bottom: 2rem; max-width: 500px; line-height: 1.6; }
      
      .btn-group {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        max-width: 350px;
      }
      
      .btn {
        display: block;
        padding: 1rem 2rem;
        font-size: 1.2rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 8px;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      
      .btn-phone {
        background-color: var(--success);
        color: white;
        box-shadow: 0 4px 6px rgba(25, 135, 84, 0.2);
      }
      
      .btn-phone:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(25, 135, 84, 0.3);
      }
      
      .btn-home {
        background-color: white;
        color: var(--primary);
        border: 2px solid var(--primary);
      }
      
      .btn-home:hover {
        background-color: var(--primary);
        color: white;
      }
      
      @media (min-width: 480px) {
        .btn-group { flex-direction: row; max-width: none; }
        .btn { flex: 1; }
      }
    </style>
  </head>
  <body>
    <div class="error-code">500</div>
    
    <!-- Inline SVG вместо Bootstrap Icons, чтобы не зависеть от CSS -->
    <svg class="icon-wrench" xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
      <path d="M1 13.286a.5.5 0 0 1 .087.286v1.909a.5.5 0 0 0 .5.5h1.909a.5.5 0 0 1 .286.087l2.637 1.319a1 1 0 0 0 .785.07l1.531-.51a1 1 0 0 0 .63-.63l.51-1.532a1 1 0 0 0-.07-.785L16.5.773a.5.5 0 0 0-.773-.773L10.314 5.714a1 1 0 0 0-.785-.07l-1.532.51a1 1 0 0 0-.63.63l-.51 1.532a1 1 0 0 0 .07.785l1.319 2.637z"/>
    </svg>
    
    <h1>Ведутся технические работы</h1>
    <p>
      К сожалению, на сервере произошла внутренняя ошибка. Я уже занимаюсь её устранением. 
      Если у вас срочный заказ или аварийная ситуация, пожалуйста, свяжитесь со мной напрямую.
    </p>
    
    <div class="btn-group">
      <a href={`tel:${cleanPhone}`} class="btn btn-phone">
        📞 {contacts.phone}
      </a>
      <a href="/" class="btn btn-home">
        🏠 Вернуться на главную
      </a>
    </div>
  </body>
</html>